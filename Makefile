GO ?= go
NPM ?= npm
BIN := bin/adroute
PREFIX ?= $(HOME)/.local

.PHONY: build install test test-race vet browser codex-test acceptance check clean

# Linux/WSL release binary. Frontend and examples are embedded by Go.
build:
	$(GO) build -trimpath -o $(BIN) ./cmd/adroute

# Install only into a user-selected prefix; this target is never run by tests.
install: build
	install -d "$(DESTDIR)$(PREFIX)/bin"
	install -m 0755 $(BIN) "$(DESTDIR)$(PREFIX)/bin/adroute"

test:
	$(GO) test ./...

test-race:
	$(GO) test -race ./...

vet:
	$(GO) vet ./...

browser:
	$(NPM) run test:browser

codex-test:
	$(NPM) run test:codex

acceptance: browser codex-test

check: vet test
	$(NPM) run check

# Removes only the binary generated by `make build`.
clean:
	rm -f $(BIN)

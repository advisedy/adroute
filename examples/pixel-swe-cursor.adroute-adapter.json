{
  "schemaVersion": 1,
  "id": "pixel-swe-cursor-tools",
  "version": "1.3.0",
  "name": "Pixel SWE · Cursor 请求兼容",
  "description": "包含 v3 响应适配，并在转发前将 instructions 中的确切短语 You operate in Cursor. 改为 You operate in an editor.；不修改其他字段或工具参数。仅绑定此版本的模型启用该改写，可能影响模型对编辑器环境的判断。",
  "engine": "responses-tools-v3",
  "options": { "lateName": true, "splitCalls": true, "neutralizeCursorInstructions": true },
  "fixtures": [
    {
      "name": "显式思考前缀不进入正文及最终快照",
      "events": [
        { "type": "response.output_item.added", "output_index": 0, "item": { "type": "message", "id": "msg_probe", "role": "assistant", "status": "in_progress", "content": [] } },
        { "type": "response.output_text.delta", "output_index": 0, "item_id": "msg_probe", "content_index": 0, "delta": "SYNTHETIC_PRIVATE_PREFIX<|close|>think<|se" },
        { "type": "response.output_text.delta", "output_index": 0, "item_id": "msg_probe", "content_index": 0, "delta": "p|><|open|>response<|sep|>答复标记。" },
        { "type": "response.output_text.done", "output_index": 0, "item_id": "msg_probe", "content_index": 0, "text": "SYNTHETIC_PRIVATE_PREFIX<|close|>think<|sep|><|open|>response<|sep|>答复标记。" },
        { "type": "response.output_item.done", "output_index": 0, "item": { "type": "message", "id": "msg_probe", "role": "assistant", "status": "completed", "content": [{ "type": "output_text", "text": "SYNTHETIC_PRIVATE_PREFIX<|close|>think<|sep|><|open|>response<|sep|>答复标记。", "annotations": [] }] } },
        { "type": "response.completed", "response": { "status": "completed", "output": [{ "type": "message", "id": "msg_final", "role": "assistant", "status": "completed", "content": [{ "type": "output_text", "text": "SYNTHETIC_PRIVATE_PREFIX<|close|>think<|sep|><|open|>response<|sep|>答复标记。", "annotations": [] }] }] } }
      ],
      "expectedCalls": [],
      "expectedTexts": ["答复标记。"]
    },
    {
      "name": "正常推理通道与中英文正文保持分离",
      "events": [
        { "type": "response.output_item.added", "output_index": 0, "item": { "type": "reasoning", "id": "rs_normal", "status": "in_progress", "summary": [] } },
        { "type": "response.reasoning_summary_text.delta", "output_index": 0, "item_id": "rs_normal", "summary_index": 0, "delta": "SYNTHETIC_SUMMARY" },
        { "type": "response.output_item.done", "output_index": 0, "item": { "type": "reasoning", "id": "rs_normal", "status": "completed", "summary": [{ "type": "summary_text", "text": "SYNTHETIC_SUMMARY" }] } },
        { "type": "response.output_item.added", "output_index": 1, "item": { "type": "message", "id": "msg_normal", "role": "assistant", "status": "in_progress", "content": [] } },
        { "type": "response.output_text.delta", "output_index": 1, "item_id": "msg_normal", "content_index": 0, "delta": "I need this sentence in the answer. 正常正文。" },
        { "type": "response.output_item.done", "output_index": 1, "item": { "type": "message", "id": "msg_normal", "role": "assistant", "status": "completed", "content": [{ "type": "output_text", "text": "I need this sentence in the answer. 正常正文。", "annotations": [] }] } },
        { "type": "response.completed", "response": { "status": "completed", "output": [{ "type": "reasoning", "id": "rs_normal", "status": "completed", "summary": [{ "type": "summary_text", "text": "SYNTHETIC_SUMMARY" }] }, { "type": "message", "id": "msg_normal", "role": "assistant", "status": "completed", "content": [{ "type": "output_text", "text": "I need this sentence in the answer. 正常正文。", "annotations": [] }] }] } }
      ],
      "expectedCalls": [],
      "expectedTexts": ["I need this sentence in the answer. 正常正文。"]
    },
    {
      "name": "拆分工具及最终 ID 变化仍保留真实 call_id",
      "events": [
        { "type": "response.output_item.added", "output_index": 0, "item": { "type": "function_call", "id": "fc_real", "call_id": "call_real", "name": "adroute_probe", "arguments": "" } },
        { "type": "response.output_item.added", "output_index": 1, "item": { "type": "function_call", "id": "fc_ghost", "call_id": "call_ghost", "name": "", "arguments": "" } },
        { "type": "response.function_call_arguments.delta", "output_index": 1, "item_id": "fc_ghost", "delta": "{\"marker\":\"adroute-test\"}" },
        { "type": "response.function_call_arguments.done", "output_index": 0, "item_id": "fc_real", "arguments": "{}" },
        { "type": "response.output_item.done", "output_index": 0, "item": { "type": "function_call", "id": "fc_real", "call_id": "call_real", "name": "adroute_probe", "arguments": "{}" } },
        { "type": "response.function_call_arguments.done", "output_index": 1, "item_id": "fc_ghost", "arguments": "{\"marker\":\"adroute-test\"}" },
        { "type": "response.output_item.done", "output_index": 1, "item": { "type": "function_call", "id": "fc_ghost", "call_id": "call_ghost", "name": "", "arguments": "{\"marker\":\"adroute-test\"}" } },
        { "type": "response.completed", "response": { "status": "completed", "output": [{ "type": "function_call", "id": "fc_real_final", "call_id": "call_real", "name": "adroute_probe", "arguments": "{}" }, { "type": "function_call", "id": "fc_ghost_final", "call_id": "call_ghost", "name": "", "arguments": "{\"marker\":\"adroute-test\"}" }] } }
      ],
      "expectedCalls": [{ "call_id": "call_real", "name": "adroute_probe", "arguments": "{\"marker\":\"adroute-test\"}" }],
      "expectedTexts": []
    }
  ]
}
